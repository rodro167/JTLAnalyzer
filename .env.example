LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-5
OUTPUT_LANGUAGE=en
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# REST API (used by `jtl-analyzer serve` and uvicorn). The API path does not
# invoke an LLM, so it needs none of the keys above.
API_HOST=0.0.0.0
API_PORT=8000
API_MAX_UPLOAD_MB=200
